{
  "captions": [
    {
      "scene": 1,
      "start": 0.0,
      "end": 1.691083,
      "text": "Who creates your Java objects?"
    },
    {
      "scene": 2,
      "start": 1.891083,
      "end": 3.06,
      "text": "Without Spring, your code"
    },
    {
      "scene": 2,
      "start": 3.06,
      "end": 4.88,
      "text": "creates a repository,"
    },
    {
      "scene": 2,
      "start": 4.88,
      "end": 6.906625,
      "text": "then passes it into a service."
    },
    {
      "scene": 3,
      "start": 7.146625,
      "end": 10.08,
      "text": "With Spring, you register bean definitions."
    },
    {
      "scene": 3,
      "start": 10.08,
      "end": 11.66,
      "text": "The container uses them to create"
    },
    {
      "scene": 3,
      "start": 11.66,
      "end": 12.62,
      "text": "managed objects"
    },
    {
      "scene": 3,
      "start": 12.62,
      "end": 15.099708,
      "text": "and wire their dependencies."
    },
    {
      "scene": 4,
      "start": 15.349708,
      "end": 18.32,
      "text": "Here, the service bean asks for a repository."
    },
    {
      "scene": 4,
      "start": 18.32,
      "end": 19.923375,
      "text": "Spring supplies that bean."
    },
    {
      "scene": 5,
      "start": 20.163375,
      "end": 21.86,
      "text": "Your application calls getBean"
    },
    {
      "scene": 5,
      "start": 21.86,
      "end": 24.18,
      "text": "to request the ready service."
    },
    {
      "scene": 5,
      "start": 24.18,
      "end": 25.7,
      "text": "In our Java run, its repository"
    },
    {
      "scene": 5,
      "start": 25.7,
      "end": 28.990625,
      "text": "is the same bean from the container."
    },
    {
      "scene": 6,
      "start": 29.250625,
      "end": 31.58,
      "text": "Your app starts Spring with Config."
    },
    {
      "scene": 6,
      "start": 31.58,
      "end": 33.18,
      "text": "Spring calls Config’s bean methods,"
    },
    {
      "scene": 6,
      "start": 33.18,
      "end": 34.02,
      "text": "creates Repo,"
    },
    {
      "scene": 6,
      "start": 34.02,
      "end": 35.92,
      "text": "and wires Service."
    },
    {
      "scene": 6,
      "start": 35.92,
      "end": 37.94,
      "text": "Your app retrieves the ready service."
    },
    {
      "scene": 6,
      "start": 37.94,
      "end": 39.962667,
      "text": "Managed beans only."
    },
    {
      "scene": 7,
      "start": 41.962667,
      "end": 43.053417,
      "text": "Thanks for watching."
    }
  ],
  "recap_cues_absolute": {
