    {
      "scene": 4,
      "start": 13.553625,
      "end": 19.020167,
      "text": "Spring passes it into the service constructor before the application places an order."
    },
    {
      "scene": 5,
      "start": 19.240167,
      "end": 24.973375,
      "text": "Our Boot test confirms the same bean. A fake gateway passes a separate service test."
