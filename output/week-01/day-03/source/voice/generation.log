  "phrases": [
    {
      "scene": 1,
      "start": 0.0,
      "end": 1.486333,
      "text": "Why isn't this a Spring bean?"
    },
    {
      "scene": 2,
      "start": 1.606333,
      "end": 8.786292,
      "text": "A class on the classpath isn't automatically registered. Give Spring a registration path."
    },
    {
      "scene": 3,
      "start": 8.966292,
      "end": 16.751125,
      "text": "Register configuration with a bean method. Spring calls the factory and manages its result."
    },
    {
      "scene": 4,
      "start": 16.931125,
      "end": 22.585917,
      "text": "Or add the component annotation, then scan the package containing your class."
    },
    {
      "scene": 5,
      "start": 22.765917,
      "end": 27.821333,
      "text": "Miss that package, and even an annotated class stays unregistered."
    },
    {
      "scene": 6,
      "start": 28.001333,
      "end": 34.679125,
      "text": "Our tests retrieve both. Two paths, one result: Spring knows which beans to manage."
    },
    {
      "scene": 7,
      "start": 36.679125,
      "end": 38.037208,
      "text": "Thanks for watching."
    }
  ],
