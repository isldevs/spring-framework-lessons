{
  "captions": [
    {
      "scene": 1,
      "start": 0.0,
      "end": 1.486333,
      "text": "Why isn't this a Spring bean?"
    },
    {
      "scene": 2,
      "start": 1.606333,
      "end": 3.12,
      "text": "A class on the classpath"
    },
    {
      "scene": 2,
      "start": 3.12,
      "end": 6.06,
      "text": "isn't automatically registered."
    },
    {
      "scene": 2,
      "start": 6.06,
      "end": 8.786292,
      "text": "Give Spring a registration path."
    },
    {
      "scene": 3,
      "start": 8.966292,
      "end": 9.92,
      "text": "Register configuration"
    },
    {
      "scene": 3,
      "start": 9.92,
      "end": 12.66,
      "text": "with a @Bean method."
    },
    {
      "scene": 3,
      "start": 12.66,
      "end": 14.02,
      "text": "Spring calls the factory"
    },
    {
      "scene": 3,
      "start": 14.02,
      "end": 16.751125,
      "text": "and manages its result."
    },
    {
      "scene": 4,
      "start": 16.931125,
      "end": 19.44,
      "text": "Or add the @Component annotation,"
    },
    {
      "scene": 4,
      "start": 19.44,
      "end": 20.54,
      "text": "then scan the package"
    },
    {
      "scene": 4,
      "start": 20.54,
      "end": 22.585917,
      "text": "containing your class."
    },
    {
      "scene": 5,
      "start": 22.765917,
      "end": 23.68,
      "text": "Miss that package,"
    },
    {
      "scene": 5,
      "start": 23.68,
      "end": 25.56,
      "text": "and even an annotated class"
    },
    {
      "scene": 5,
      "start": 25.56,
      "end": 27.821333,
      "text": "stays unregistered."
    },
    {
      "scene": 6,
      "start": 28.001333,
      "end": 29.64,
      "text": "Our tests retrieve both."
    },
    {
      "scene": 6,
      "start": 29.64,
      "end": 31.88,
      "text": "Two paths, one result:"
    },
    {
      "scene": 6,
      "start": 31.88,
      "end": 34.679125,
      "text": "Spring knows which beans to manage."
    },
    {
      "scene": 7,
      "start": 36.679125,
      "end": 38.037208,
      "text": "Thanks for watching."
    }
  ],
