{
  "captions": [
    {
      "scene": 1,
      "start": 0.0,
      "end": 0.98,
      "text": "How does an order service"
    },
    {
      "scene": 1,
      "start": 0.98,
      "end": 2.706958,
      "text": "get its payment gateway?"
    },
    {
      "scene": 2,
      "start": 2.886958,
      "end": 4.24,
      "text": "Require a payment gateway"
    },
    {
      "scene": 2,
      "start": 4.24,
      "end": 5.34,
      "text": "in the constructor,"
    },
    {
      "scene": 2,
      "start": 5.34,
      "end": 8.2975,
      "text": "and keep its reference in a final field."
    },
    {
      "scene": 3,
      "start": 8.5175,
      "end": 10.46,
      "text": "Boot scans the components."
    },
    {
      "scene": 3,
      "start": 10.46,
      "end": 11.68,
      "text": "One gateway bean matches"
    },
    {
      "scene": 3,
      "start": 11.68,
      "end": 13.333625,
      "text": "that interface type."
    },
    {
      "scene": 4,
      "start": 13.553625,
      "end": 14.82,
      "text": "Spring passes it into"
    },
    {
      "scene": 4,
      "start": 14.82,
      "end": 16.08,
      "text": "the service constructor"
    },
    {
      "scene": 4,
      "start": 16.08,
      "end": 19.020167,
      "text": "before the application places an order."
    },
    {
      "scene": 5,
      "start": 19.240167,
      "end": 21.82,
      "text": "Our Boot test confirms the same bean."
    },
    {
      "scene": 5,
      "start": 21.82,
      "end": 22.96,
      "text": "A fake gateway passes"
    },
    {
      "scene": 5,
      "start": 22.96,
      "end": 24.973375,
      "text": "a separate service test."
    },
    {
      "scene": 6,
      "start": 25.193375,
      "end": 27.66,
      "text": "Require, resolve, inject, then use."
    },
    {
      "scene": 6,
      "start": 27.66,
      "end": 29.66,
      "text": "Constructor injection makes"
    },
    {
      "scene": 6,
      "start": 29.66,
      "end": 32.283125,
      "text": "required dependencies explicit."
    },
    {
      "scene": 7,
      "start": 34.283125,
      "end": 35.469167,
      "text": "Thanks for watching."
    }
  ],
