{
  "captions": [
    {
      "scene": 1,
      "start": 0.0,
      "end": 1.4615,
      "text": "Why isn't this a Spring bean?"
    },
    {
      "scene": 2,
      "start": 1.5415,
      "end": 2.34,
      "text": "The class compiles,"
    },
    {
      "scene": 2,
      "start": 2.34,
      "end": 3.76,
      "text": "but the context has no"
    },
    {
      "scene": 2,
      "start": 3.76,
      "end": 5.24,
      "text": "registration for it."
    },
    {
      "scene": 2,
      "start": 5.24,
      "end": 7.17225,
      "text": "Asking for Client fails."
    },
    {
      "scene": 3,
      "start": 7.25225,
      "end": 8.26,
      "text": "Register FactoryConfig,"
    },
    {
      "scene": 3,
      "start": 8.26,
      "end": 9.84,
      "text": "then refresh."
    },
    {
      "scene": 3,
      "start": 9.84,
      "end": 11.6,
      "text": "Its @Bean method returns the Client"
    },
    {
      "scene": 3,
      "start": 11.6,
      "end": 13.295667,
      "text": "that Spring manages."
    },
    {
      "scene": 4,
      "start": 13.375667,
      "end": 14.54,
      "text": "Or add the @Component annotation"
    },
    {
      "scene": 4,
      "start": 14.54,
      "end": 15.78,
      "text": "to Worker,"
    },
    {
      "scene": 4,
      "start": 15.78,
      "end": 18.42,
      "text": "then configure a scan of its package."
    },
    {
      "scene": 4,
      "start": 18.42,
      "end": 20.587292,
      "text": "Spring discovers and registers it."
    },
    {
      "scene": 5,
      "start": 20.667292,
      "end": 23.02,
      "text": "The scan covers lesson.scan."
    },
    {
      "scene": 5,
      "start": 23.02,
      "end": 24.7,
      "text": "Outside lives in another package,"
    },
    {
      "scene": 5,
      "start": 24.7,
      "end": 26.983,
      "text": "so its annotation isn't picked up."
    },
    {
      "scene": 6,
      "start": 27.063,
      "end": 28.14,
      "text": "Our three tests pass:"
    },
    {
      "scene": 6,
      "start": 28.14,
      "end": 30.34,
      "text": "both registered beans are found;"
    },
    {
      "scene": 6,
      "start": 30.34,
      "end": 31.64,
      "text": "the class outside the scan"
    },
    {
      "scene": 6,
      "start": 31.64,
      "end": 33.06,
      "text": "stays missing."
    },
    {
      "scene": 6,
      "start": 33.06,
      "end": 34.36,
      "text": "Registration tells Spring"
    },
    {
      "scene": 6,
      "start": 34.36,
      "end": 35.89,
      "text": "what to manage."
    },
    {
      "scene": 7,
      "start": 37.89,
      "end": 38.98075,
      "text": "Thanks for watching."
    }
  ],
