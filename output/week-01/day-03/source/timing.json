  "phrases": [
    {
      "scene": 1,
      "start": 0.0,
      "end": 2.706958,
      "text": "How does an order service get its payment gateway?"
    },
    {
      "scene": 2,
      "start": 2.886958,
      "end": 8.2975,
      "text": "Require a payment gateway in the constructor, and keep its reference in a final field."
    },
    {
      "scene": 3,
      "start": 8.5175,
      "end": 13.333625,
      "text": "Boot scans the components. One gateway bean matches that interface type."
    },
    {
      "scene": 4,
      "start": 13.553625,
      "end": 19.020167,
      "text": "Spring passes it into the service constructor before the application places an order."
    },
    {
      "scene": 5,
      "start": 19.240167,
      "end": 24.973375,
      "text": "Our Boot test confirms the same bean. A fake gateway passes a separate service test."
    },
    {
      "scene": 6,
      "start": 25.193375,
      "end": 32.283125,
      "text": "Require, resolve, inject, then use. Constructor injection makes required dependencies explicit."
    },
    {
      "scene": 7,
      "start": 34.283125,
      "end": 35.469167,
      "text": "Thanks for watching."
    }
  ],
