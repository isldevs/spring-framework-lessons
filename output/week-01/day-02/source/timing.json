  "phrases": [
    {
      "scene": 1,
      "start": 0.0,
      "end": 2.193917,
      "text": "How does a repository reach your service?"
    },
    {
      "scene": 2,
      "start": 2.373917,
      "end": 7.162792,
      "text": "Configured scanning finds annotated classes and registers bean definitions."
    },
    {
      "scene": 3,
      "start": 7.382792,
      "end": 12.75075,
      "text": "A single constructor needs a repository. Spring resolves that parameter by type."
    },
    {
      "scene": 4,
      "start": 12.97075,
      "end": 18.221708,
      "text": "Spring creates the repository, then passes its reference into the service constructor."
    },
    {
      "scene": 5,
      "start": 18.441708,
      "end": 24.933958,
      "text": "Our Java run confirms the same repository bean. Only then does the application use the service."
    },
    {
      "scene": 6,
      "start": 25.153958,
      "end": 32.209083,
      "text": "Scan, register, resolve, inject, then use. Spring supplies dependencies; your service doesn’t construct them."
    },
    {
      "scene": 7,
      "start": 34.209083,
      "end": 35.299833,
      "text": "Thanks for watching."
    }
  ],
