{
  "captions": [
    {
      "scene": 1,
      "start": 0.0,
      "end": 1.963,
      "text": "What's inside ApplicationContext?"
    },
    {
      "scene": 2,
      "start": 2.083,
      "end": 4.5,
      "text": "Bean definitions are recipes."
    },
    {
      "scene": 2,
      "start": 4.5,
      "end": 5.16,
      "text": "Managed instances"
    },
    {
      "scene": 2,
      "start": 5.16,
      "end": 7.376042,
      "text": "are the actual objects."
    },
    {
      "scene": 3,
      "start": 7.556042,
      "end": 9.42,
      "text": "Register configuration,"
    },
    {
      "scene": 3,
      "start": 9.42,
      "end": 10.8,
      "text": "then refresh."
    },
    {
      "scene": 3,
      "start": 10.8,
      "end": 12.02,
      "text": "Spring reads the definitions"
    },
    {
      "scene": 3,
      "start": 12.02,
      "end": 14.796708,
      "text": "and creates our singleton beans."
    },
    {
      "scene": 4,
      "start": 14.976708,
      "end": 16.88,
      "text": "Calling getBean returns the service,"
    },
    {
      "scene": 4,
      "start": 16.88,
      "end": 19.860875,
      "text": "already wired to its repository."
    },
    {
      "scene": 5,
      "start": 20.040875,
      "end": 22.48,
      "text": "The context also publishes events."
    },
    {
      "scene": 5,
      "start": 22.48,
      "end": 22.92,
      "text": "Close it,"
    },
    {
      "scene": 5,
      "start": 22.92,
      "end": 24.95625,
      "text": "and managed cleanup runs."
    },
    {
      "scene": 6,
      "start": 25.13625,
      "end": 27.04,
      "text": "Our tests confirm: same service,"
    },
    {
      "scene": 6,
      "start": 27.04,
      "end": 28.58,
      "text": "one event, cleanup called."
    },
    {
      "scene": 6,
      "start": 28.58,
      "end": 30.02,
      "text": "Definitions describe;"
    },
    {
      "scene": 6,
      "start": 30.02,
      "end": 32.275958,
      "text": "instances do the work."
    },
    {
      "scene": 7,
      "start": 34.275958,
      "end": 35.462,
      "text": "Thanks for watching."
    }
  ],
