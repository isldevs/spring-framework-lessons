{
  "captions": [
    {
      "scene": 1,
      "start": 0.0,
      "end": 2.193917,
      "text": "How does a repository reach your service?"
    },
    {
      "scene": 2,
      "start": 2.373917,
      "end": 4.68,
      "text": "Configured scanning finds annotated classes"
    },
    {
      "scene": 2,
      "start": 4.68,
      "end": 7.162792,
      "text": "and registers bean definitions."
    },
    {
      "scene": 3,
      "start": 7.382792,
      "end": 10.18,
      "text": "A single constructor needs a repository."
    },
    {
      "scene": 3,
      "start": 10.18,
      "end": 12.75075,
      "text": "Spring resolves that parameter by type."
    },
    {
      "scene": 4,
      "start": 12.97075,
      "end": 15.12,
      "text": "Spring creates the repository,"
    },
    {
      "scene": 4,
      "start": 15.12,
      "end": 16.22,
      "text": "then passes its reference"
    },
    {
      "scene": 4,
      "start": 16.22,
      "end": 18.221708,
      "text": "into the service constructor."
    },
    {
      "scene": 5,
      "start": 18.441708,
      "end": 19.62,
      "text": "Our Java run confirms"
    },
    {
      "scene": 5,
      "start": 19.62,
      "end": 21.9,
      "text": "the same repository bean."
    },
    {
      "scene": 5,
      "start": 21.9,
      "end": 23.2,
      "text": "Only then does the application"
    },
    {
      "scene": 5,
      "start": 23.2,
      "end": 24.933958,
      "text": "use the service."
    },
    {
      "scene": 6,
      "start": 25.153958,
      "end": 27.82,
      "text": "Scan, register, resolve, inject, then use."
    },
    {
      "scene": 6,
      "start": 27.82,
      "end": 29.76,
      "text": "Spring supplies dependencies;"
    },
    {
      "scene": 6,
      "start": 29.76,
      "end": 32.209083,
      "text": "your service doesn’t construct them."
    },
    {
      "scene": 7,
      "start": 34.209083,
      "end": 35.299833,
      "text": "Thanks for watching."
    }
  ],
