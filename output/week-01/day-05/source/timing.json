    {
      "scene": 1,
      "start": 0.0,
      "end": 1.787625,
      "text": "Two names. One ambiguous type."
    },
    {
      "scene": 2,
      "start": 1.867625,
      "end": 8.20825,
      "text": "This factory method registers a Client named alpha. The annotation supplies its explicit bean name."
    },
    {
      "scene": 3,
      "start": 8.28825,
      "end": 14.389875,
      "text": "Ask for alpha by name, and Spring returns that bean. Add the type argument to check its type too."
    },
    {
      "scene": 4,
      "start": 14.469875,
      "end": 21.633917,
      "text": "With just one Client, a type-only lookup returns the same object. Now register beta as a second Client."
    },
    {
      "scene": 5,
      "start": 21.713917,
      "end": 28.953042,
      "text": "Both beans have clear names, but both match Client. With no primary selected, this type-only lookup is ambiguous."
    },
    {
      "scene": 6,
      "start": 29.033042,
      "end": 35.945417,
      "text": "Our tests verify named results and type failure. Names identify beans; they don't resolve this type tie."
    },
    {
      "scene": 7,
      "start": 37.945417,
      "end": 39.036167,
      "text": "Thanks for watching."
    }
  ],
