      "scene": 1,
      "start": 0.0,
      "end": 1.755125,
      "text": "No Autowired? This still works."
    },
    {
      "scene": 2,
      "start": 1.835125,
      "end": 8.5915,
      "text": "This Spring-managed service has one constructor. Spring selects it automatically. Autowired is optional here."
    },
    {
      "scene": 3,
      "start": 8.6715,
      "end": 14.727,
      "text": "Spring reads its parameter type: PaymentGateway. In our context, one matching bean is available."
    },
    {
      "scene": 4,
      "start": 14.807,
      "end": 19.433125,
      "text": "Spring supplies that instance through the constructor. The service keeps the reference."
    },
    {
      "scene": 5,
      "start": 19.513125,
      "end": 25.706708,
      "text": "Now an order calls the injected gateway. Our test checks the same instance and the returned result."
    },
    {
      "scene": 6,
      "start": 25.786708,
      "end": 32.921167,
      "text": "Creating an object with new still means supplying arguments yourself. Let Spring wire the beans it manages."
    },
    {
      "scene": 7,
      "start": 34.921167,
      "end": 36.011917,
      "text": "Thanks for watching."
    }
